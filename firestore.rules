rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function valid(data) {
      return data.keys().hasOnly(['schema','revision','payload','deleted','operationId','device','updatedAt'])
        && data.keys().hasAll(['schema','revision','payload','deleted','operationId','device','updatedAt'])
        && data.schema == 1 && data.revision is int && data.revision > 0
        && data.payload is string && data.payload.size() <= 800000
        && data.deleted is bool && (!data.deleted || data.payload == '')
        && data.operationId is string && data.operationId.size() == 36
        && data.device is string && data.device.size() > 0 && data.device.size() <= 128
        && data.updatedAt == request.time;
    }
    match /users/{uid}/records/{recordId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && valid(request.resource.data)
        && request.resource.data.revision == 1
        && getAfter(/databases/$(database)/documents/users/$(uid)/records/$(recordId)/history/1).data == request.resource.data;
      allow update: if owner(uid) && valid(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && getAfter(/databases/$(database)/documents/users/$(uid)/records/$(recordId)/history/$(string(request.resource.data.revision))).data == request.resource.data;
      allow delete: if false;
      match /history/{revision} {
        allow read: if owner(uid);
        allow create: if owner(uid) && valid(request.resource.data)
          && revision == string(request.resource.data.revision)
          && getAfter(/databases/$(database)/documents/users/$(uid)/records/$(recordId)).data == request.resource.data;
        allow update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
